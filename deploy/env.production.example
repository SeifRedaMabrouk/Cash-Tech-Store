# انسخ الملف ده لـ .env على السيرفر (ماترفعهوش على GitHub أبدًا)
NODE_ENV=production
APP_ORIGIN=https://your-domain.com
HOST=127.0.0.1
PORT=3000
DATA_DIR=/srv/cashtech/data
SEED_DEMO=0
TRUST_PROXY=1
# النسخ الاحتياطي بره فولدر data
BACKUP_DIR=/srv/cashtech/backups
# إيميل التواصل الظاهر للزوار (للتحذير لو استخدمته كإيميل إدارة بالغلط)
CONTACT_EMAIL=info@your-domain.com
