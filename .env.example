# رابط الاتصال بقاعدة Neon (Pooled connection). سري جدًا: مكانه الوحيد ملف .env المحلي (مش بيترفع على GitHub) وإعدادات Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# العنوان الحقيقي للموقع بدون / في الآخر، مثال https://cash-tech.vercel.app أو دومينك. على Vercel لو سبته فاضي بيستخدم دومين المشروع تلقائيًا.
APP_ORIGIN=http://127.0.0.1:3000
# للتشغيل المحلي فقط (npm start)
HOST=127.0.0.1
PORT=3000
SEED_DEMO=0
# على Vercel بيتظبط لوحده على 1. محليًا خليه 0.
TRUST_PROXY=0
